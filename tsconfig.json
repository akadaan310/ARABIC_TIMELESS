{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "ES2022"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@engine/corpus": ["packages/corpus/index.ts"],
      "@engine/provenance": ["packages/provenance/index.ts"],
      "@engine/relation": ["packages/relation/index.ts"],
      "@engine/discovery": ["packages/discovery/index.ts"],
      "@engine/arabic": ["packages/arabic/index.ts"],
      "@engine/structure": ["packages/structure/index.ts"],
      "@engine/spatial": ["packages/spatial/index.ts"],
      "@engine/capability": ["packages/capability/index.ts"],
      "@engine/traversal": ["packages/traversal/index.ts"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
